# Note: summarization no longer calls an API - you ask Claude Code to
# summarize a session directly in chat, and it writes the knowledge JSON
# into the session file itself. No Anthropic key needed for that anymore.

# TWG CLI (used by `agent-knowledge push --via twg`, the default).
# TWG mediates the Jira write instead of talking to Jira's REST API directly -
# it holds its own Jira + Bitbucket auth from `twg login` / `twg setup`, so no
# token is needed here. Only set this if `twg` isn't on your PATH.
# TWG_CLI_PATH=C:\Users\you\AppData\Local\Programs\twg\bin\twg.exe

# Jira REST fallback (used by `agent-knowledge push --via api`)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
